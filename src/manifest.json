{
  "manifest_version": 3,
  "name": "Edge → Raindrop Sync",
  "version": "0.1.0",
  "description": "Sync Microsoft Edge bookmarks with Raindrop.io (one-way or bidirectional), captured as you create them.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["https://api.raindrop.io/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Edge → Raindrop Sync"
  }
}
